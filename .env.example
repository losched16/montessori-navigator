# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic Claude API
NAVIGATOR_ANTHROPIC_API_KEY=your_anthropic_api_key

# Stripe (test keys for development)
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe price IDs (one per plan)
STRIPE_PRICE_ID_SCHOOL=price_...             # $12/family/year — school Digital tier
STRIPE_PRICE_ID_SCHOOL_PRINT=price_...       # $25/family/year — school Digital+Print tier
STRIPE_PRICE_ID_INDIVIDUAL_MONTHLY=price_... # $8/month for individuals
STRIPE_PRICE_ID_INDIVIDUAL_ANNUAL=price_... # $59/year for individuals

# Supabase Service Role (for webhooks — never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
